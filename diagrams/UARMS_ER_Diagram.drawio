<mxfile host="app.diagrams.net">
  <diagram id="uarms-er" name="UARMS ER Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Legend and constraint notes -->
        <mxCell id="legend" value="&lt;b&gt;UARMS - ER Diagram&lt;/b&gt;&lt;br&gt;Crow's foot notation&lt;br&gt;Bar = exactly one&lt;br&gt;Circle + bar = zero or one&lt;br&gt;Circle + crow's foot = zero or many&lt;br&gt;[PK] primary key, [FK] foreign key&lt;br&gt;Edge label = foreign key column" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="40" width="190" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Planned constraints&lt;/b&gt;&lt;br&gt;enrollment.course_id: ON DELETE RESTRICT&lt;br&gt;UNIQUE (student_id, course_id, semester_id) on enrollment&lt;br&gt;UNIQUE (enrollment_id) on grade&lt;br&gt;UNIQUE username, email on person&lt;br&gt;Indexes: enrollment student_id, course_id, semester_id&lt;br&gt;department.head_of_department_id: nullable, FK added with ALTER TABLE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="150" as="geometry"/>
        </mxCell>

        <!-- ============ TABLES ============ -->

        <mxCell id="person" value="person" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=26;html=1;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="250" height="347" as="geometry"/>
        </mxCell>
        <mxCell id="person_a" value="person_id: INT [PK]&lt;br&gt;title: VARCHAR&lt;br&gt;first_name: VARCHAR&lt;br&gt;middle_name: VARCHAR&lt;br&gt;last_name: VARCHAR&lt;br&gt;date_of_birth: DATE&lt;br&gt;gender: VARCHAR&lt;br&gt;nationality: VARCHAR&lt;br&gt;email: VARCHAR&lt;br&gt;phone: VARCHAR&lt;br&gt;street_address: VARCHAR&lt;br&gt;digital_address: VARCHAR&lt;br&gt;city: VARCHAR&lt;br&gt;region: VARCHAR&lt;br&gt;country: VARCHAR&lt;br&gt;emergency_contact_name: VARCHAR&lt;br&gt;emergency_contact_phone: VARCHAR&lt;br&gt;username: VARCHAR&lt;br&gt;password_hash: VARCHAR&lt;br&gt;user_role: VARCHAR&lt;br&gt;account_status: VARCHAR" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="person">
