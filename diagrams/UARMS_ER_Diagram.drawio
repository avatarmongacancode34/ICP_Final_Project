        <!-- ============ RELATIONSHIPS (one side is the source, many side is the target) ============ -->

        <!-- person to student, faculty, admin: one person has at most one role row -->
        <mxCell id="r1" value="person_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;labelBackgroundColor=#ffffff;startArrow=ERmandOne;startSize=10;endArrow=ERzeroToOne;endSize=10;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="person" target="student">
